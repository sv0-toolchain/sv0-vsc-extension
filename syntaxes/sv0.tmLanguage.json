{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "sv0",
  "scopeName": "source.sv0",
  "_provenance": {
    "repo": "sv0doc",
    "revision": "451fcd9e4a09bb4c17eb8f45d8fdf861dce9f293",
    "sources": [
      "keywords/reference.md",
      "grammar/sv0.ebnf"
    ],
    "note": "Scaffold grammar (VSC-S-101/114). Full LANG-001..010 golden-test coverage is a separate slice; this seeds the keyword/operator/literal tables from the pinned sv0doc revision above."
  },
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#contract-keywords" },
    { "include": "#control-keywords" },
    { "include": "#declaration-keywords" },
    { "include": "#other-keywords" },
    { "include": "#primitive-types" },
    { "include": "#constants" },
    { "include": "#self" },
    { "include": "#operators" },
    { "include": "#function-call" },
    { "include": "#types" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.sv0",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.sv0",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sv0",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sv0",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#escapes" }
      ]
    },
    "characters": {
      "name": "string.quoted.single.sv0",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "include": "#escapes" }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.sv0",
          "match": "\\\\(n|r|t|\\\\|'|\"|0)"
        },
        {
          "name": "constant.character.escape.hex.sv0",
          "match": "\\\\x[0-9a-fA-F]{2}"
        },
        {
          "name": "constant.character.escape.unicode.sv0",
          "match": "\\\\u\\{[0-9a-fA-F]+\\}"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.sv0",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.hex.sv0",
          "match": "\\b0x[0-9a-fA-F_]+(i8|i16|i32|i64|u8|u16|u32|u64|usize|isize)?\\b"
        },
        {
          "name": "constant.numeric.integer.octal.sv0",
          "match": "\\b0o[0-7_]+(i8|i16|i32|i64|u8|u16|u32|u64|usize|isize)?\\b"
        },
        {
          "name": "constant.numeric.integer.binary.sv0",
          "match": "\\b0b[01_]+(i8|i16|i32|i64|u8|u16|u32|u64|usize|isize)?\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.sv0",
          "match": "\\b[0-9][0-9_]*(i8|i16|i32|i64|u8|u16|u32|u64|usize|isize)?\\b"
        }
      ]
    },
    "contract-keywords": {
      "name": "keyword.other.contract.sv0",
      "match": "\\b(requires|ensures|loop_invariant|old|forall|exists|borrows|no_alias|result)\\b"
    },
    "control-keywords": {
      "name": "keyword.control.sv0",
      "match": "\\b(if|else|match|while|for|in|loop|break|continue|return)\\b"
    },
    "declaration-keywords": {
      "name": "keyword.declaration.sv0",
      "match": "\\b(let|mut|const|static|fn|struct|enum|trait|impl|type|newtype|where|pub|module|use)\\b"
    },
    "other-keywords": {
      "name": "keyword.other.sv0",
      "match": "\\b(unsafe|move|as|assert|project)\\b"
    },
    "primitive-types": {
      "name": "storage.type.primitive.sv0",
      "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|usize|isize|f32|f64|bool|char|str)\\b"
    },
    "constants": {
      "name": "constant.language.sv0",
      "match": "\\b(true|false)\\b"
    },
    "self": {
      "name": "variable.language.self.sv0",
      "match": "\\b(self|Self)\\b"
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.sv0"
    },
    "types": {
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
      "name": "entity.name.type.sv0"
    },
    "operators": {
      "_comment": "Order matters: vscode-textmate's underlying oniguruma scanner breaks same-start-position ties by ARRAY ORDER, not match length. Every entry here that could tie with a shorter overlapping alternative from a later entry (e.g. shift <<= vs shift << vs comparison <) must be listed before it. See test/unit/grammar.test.ts LANG-005 for the regression coverage.",
      "patterns": [
        {
          "name": "keyword.operator.range.sv0",
          "match": "\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.assignment.sv0",
          "comment": "compound shift-assign forms must precede plain shift (<<) and comparison (<)",
          "match": "<<=|>>="
        },
        {
          "name": "keyword.operator.shift.sv0",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.sv0",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.sv0",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.sv0",
          "comment": "remaining compound-assign forms + plain =, after comparison's == and after logical's && / ||, before the bitwise/arithmetic single-char fallbacks they'd otherwise tie with",
          "match": "=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.error-propagation.sv0",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.bitwise.sv0",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.sv0",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    }
  }
}
