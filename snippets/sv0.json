{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:i32} {",
      "\t${0}",
      "}"
    ],
    "description": "Function definition"
  },
  "Main function": {
    "prefix": "main",
    "body": [
      "fn main() -> i32 {",
      "\t${0}",
      "\treturn 0;",
      "}"
    ],
    "description": "Program entry point"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:i32},${0}",
      "}"
    ],
    "description": "Struct definition"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Variant},${0}",
      "}"
    ],
    "description": "Enum definition"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:pattern} => ${0},",
      "}"
    ],
    "description": "Match expression"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "If statement"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "While loop"
  },
  "For": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:iterable} {",
      "\t${0}",
      "}"
    ],
    "description": "For loop"
  },
  "Requires clause": {
    "prefix": "requires",
    "body": "requires(${1:condition})",
    "description": "Function precondition contract"
  },
  "Ensures clause": {
    "prefix": "ensures",
    "body": "ensures(${1:condition})",
    "description": "Function postcondition contract"
  },
  "Loop invariant": {
    "prefix": "loop_invariant",
    "body": "loop_invariant(${1:condition})",
    "description": "Loop invariant contract"
  }
}
